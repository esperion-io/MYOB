{
  "name": "myob-inventory-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "MYOB Business API foundation for a multi-client inventory dashboard",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/check-ledger-boundary.mjs && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check:ledger": "node scripts/check-ledger-boundary.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
