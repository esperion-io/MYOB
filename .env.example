# Server
PORT=3000
APP_BASE_URL=http://localhost:3000

# MYOB Developer App credentials from my.MYOB → Developer → Register App
# https://developer.myob.com / https://my.myob.com
MYOB_API_KEY=your_api_key_here
MYOB_API_SECRET=your_api_secret_here

# Must match the Redirect URI registered on your MYOB app exactly.
# Post-March 2025 keys generally require https:// redirect URIs.
# For local HTTPS, use a tunnel (e.g. ngrok) or register an https localhost URI.
MYOB_REDIRECT_URI=http://localhost:3000/auth/callback

# Space-separated OAuth scopes (new SME scopes for keys created after March 2025).
# sme-company-file is required. Contact is split across four scopes for full /Contact access.
# sme-sales → /Sale/*, sme-purchases → /Purchase/*, sme-inventory → /Inventory/*.
MYOB_SCOPES=sme-company-file sme-contacts-customer sme-contacts-supplier sme-contacts-employee sme-contacts-personal sme-sales sme-purchases sme-inventory

# Cloud API host. Prefer arl2 for current Business/AccountRight Online files.
MYOB_API_BASE_URL=https://arl2.api.myob.com/accountright

# Optional: company-file login for x-myobapi-cftoken (Base64 username:password).
# Often needed for older/desktop-style access; may be optional for admin OAuth on cloud files.
# Leave blank to omit the header.
MYOB_CF_USERNAME=
MYOB_CF_PASSWORD=

# Where OAuth tokens / connected company files are stored (dev only).
DATA_DIR=.data
