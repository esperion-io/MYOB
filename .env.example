# Server
PORT=3000
APP_BASE_URL=http://localhost:3000

# MYOB Developer App credentials from my.MYOB → Developer → Register App
# https://developer.myob.com / https://my.myob.com
# Set on the Render service only. Off Render the app ignores them: MYOB is off
# on a development machine, on purpose (production's MYOB login is single-use).
# Never put a MYOB key in .env or .env.local.
MYOB_API_KEY=
MYOB_API_SECRET=

# Must match the Redirect URI registered on your MYOB app exactly.
# Post-March 2025 keys generally require https:// redirect URIs.
# On Render this is the service's https://…/auth/callback. MYOB is never connected
# from a development machine (production's MYOB login is single-use).
MYOB_REDIRECT_URI=http://localhost:3000/auth/callback

# Space-separated OAuth scopes (new SME scopes for keys created after March 2025).
# sme-company-file is required. Contact is split across four scopes for full /Contact access.
# sme-sales → /Sale/*, sme-purchases → /Purchase/*, sme-inventory → /Inventory/*.
MYOB_SCOPES=sme-company-file sme-contacts-customer sme-contacts-supplier sme-contacts-employee sme-contacts-personal sme-sales sme-purchases sme-inventory

# Cloud API host. Prefer arl2 for current Business/AccountRight Online files.
MYOB_API_BASE_URL=https://arl2.api.myob.com/accountright

# Optional: company-file login for x-myobapi-cftoken (Base64 username:password).
# Often needed for older/desktop-style access; may be optional for admin OAuth on cloud files.
# Leave blank to omit the header.
MYOB_CF_USERNAME=
MYOB_CF_PASSWORD=

# Postgres. On Render it comes from the service's environment.
# Locally: the local copy only, e.g. postgres://localhost:5432/allied_dev
# (see CLAUDE.md in the folder above this repository). Off Render the app
# refuses any host but localhost, 127.0.0.1 or ::1 (a bracketed [::1] is
# refused: write localhost). Leave blank to use the .data file store.
DATABASE_URL=

# Optional: encrypt tokens at rest in Postgres. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# File-backed fallback when DATABASE_URL is empty (local/dev only).
DATA_DIR=.data

# ---- Inventory intelligence dashboard ----
# Days of transactional history mirrored from MYOB on a full sync.
SYNC_WINDOW_DAYS=365
# Stock-cover target (weeks) used by purchasing suggestions.
TARGET_COVER_WEEKS=8
# Auto-run an incremental sync every N hours while the server is awake (0 = off).
# Render only: off Render the app never schedules a sync, whatever this says.
SYNC_INTERVAL_HOURS=0
# Shared access key for /api/insights endpoints and the dashboard UI.
# Leave blank to disable (local dev). Set in production.
DASHBOARD_ACCESS_KEY=
